{
  "info": {
    "_postman_id": "campusfix-api-v1",
    "name": "CampusFix API",
    "description": "Production API Collection for CampusFix Facility Complaint & Service Request System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "sampleTicketId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "System Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@campusfix.edu\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Technician)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech.electrical@campusfix.edu\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Reporter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reporter1@campusfix.edu\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Current Session (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Master Data",
      "item": [
        {
          "name": "List Active Buildings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/buildings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buildings"]
            }
          }
        },
        {
          "name": "List Rooms for Building",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/buildings/replace-with-building-id/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "buildings", "replace-with-building-id", "rooms"]
            }
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            }
          }
        },
        {
          "name": "List Technicians with Workload",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/technicians",
              "host": ["{{baseUrl}}"],
              "path": ["api", "technicians"]
            }
          }
        }
      ]
    },
    {
      "name": "Tickets & Workflow",
      "item": [
        {
          "name": "List Tickets (Role Scoped & Filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets?page=1&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "25" }
              ]
            }
          }
        },
        {
          "name": "Get Ticket Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}"]
            }
          }
        },
        {
          "name": "Get Ticket Status History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "history"]
            }
          }
        },
        {
          "name": "Update Priority (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"HIGH\",\n  \"reason\": \"High traffic examination room, repair required immediately.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/priority",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "priority"]
            }
          }
        },
        {
          "name": "Assign Technician & Target Date (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": \"replace-with-tech-uuid\",\n  \"targetDate\": \"2026-11-26T16:00:00.000Z\",\n  \"note\": \"Please inspect electrical breaker box upon arrival.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "assign"]
            }
          }
        },
        {
          "name": "Transition Status (Start / Hold / Resolve)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"note\": \"Starting site diagnostic now.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "status"]
            }
          }
        },
        {
          "name": "Check Duplicate Tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/duplicates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "duplicates"]
            }
          }
        },
        {
          "name": "Merge Duplicate Ticket (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryTicketId\": \"replace-with-primary-ticket-id\",\n  \"reason\": \"Duplicate complaint reported for same room.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/merge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "merge"]
            }
          }
        }
      ]
    },
    {
      "name": "Closure & Feedback",
      "item": [
        {
          "name": "Confirm Resolution (Reporter)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Quick repair, thank you!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "confirm"]
            }
          }
        },
        {
          "name": "Reopen Ticket (Reporter within 3 Days)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Light flickering began again shortly after technician left.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/reopen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "reopen"]
            }
          }
        },
        {
          "name": "Submit Feedback Rating",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"comment\": \"Clean and professional work.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{sampleTicketId}}/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{sampleTicketId}}", "feedback"]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard & Reports",
      "item": [
        {
          "name": "Executive Summary Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "summary"]
            }
          }
        },
        {
          "name": "Unresolved Tickets Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard/unresolved?sort=age_desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard", "unresolved"],
              "query": [
                { "key": "sort", "value": "age_desc" }
              ]
            }
          }
        },
        {
          "name": "Export Tickets CSV",
          "request": {
            "method": "GET",
